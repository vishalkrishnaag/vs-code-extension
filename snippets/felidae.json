{
  "Import": {
    "prefix": "import",
    "body": ["import \"${1:file.fx}\"."],
    "description": "Import a Felidae source file"
  },
  "Persistent Fact": {
    "prefix": "fact",
    "body": ["def ${1:employee}(${2:id}: ${3:\"e1\"}, ${4:state}: ${5:active})."],
    "description": "Declare a persistent fact seed"
  },
  "Immutable Binding": {
    "prefix": "binding",
    "body": ["def ${1:value}${2:: ${3:any}} := ${4:expression}."],
    "description": "Declare an immutable interpreter binding"
  },
  "Function": {
    "prefix": "function",
    "body": [
      "def ${1:name}(${2:value}: ${3:any}) =>",
      "    ${4:expression}.",
      "end"
    ],
    "description": "Declare an implicit-result function"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "def main() =>",
      "    ${1:expression}.",
      "end"
    ],
    "description": "Declare the program entry function"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:entity}",
      "    key(${2:id}).",
      "    def ${2:id}: ${3:string}.",
      "    def ${4:enabled}: ${5:bool} := ${6:true}.",
      "end"
    ],
    "description": "Declare a RocksDB-backed fact schema"
  },
  "Conditional Expression": {
    "prefix": "condition",
    "body": ["${1:left} = ${2:right} then ${3:value} else ${4:fallback}."],
    "description": "Create a conditional expression"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:values} then",
      "    ${3:expression}.",
      "end"
    ],
    "description": "Iterate a list or lazy query cursor"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} then",
      "    ${2:expression}.",
      "end"
    ],
    "description": "Repeat while a Boolean condition is true"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:value}",
      "case ${2:expected} then",
      "    ${3:expression}.",
      "default then",
      "    ${4:fallback}.",
      "end"
    ],
    "description": "Create an explicit-break switch block"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try",
      "    ${1:expression}.",
      "catch ${2:error} then",
      "    ${3:error.message}.",
      "end"
    ],
    "description": "Catch a Felidae runtime exception"
  },
  "Throw": {
    "prefix": "throw",
    "body": ["throw(kind: ${1:runtime}, message: ${2:\"failed\"})."],
    "description": "Raise a structured exception"
  },
  "Bucket Query": {
    "prefix": "query",
    "body": ["${1:employee}.where(${2:active}: ${3:true})."],
    "description": "Create a period-terminated RocksDB bucket query"
  },
  "Link": {
    "prefix": "link",
    "body": [
      "Link(",
      "    from: ${1:left},",
      "    to: ${2:right},",
      "    properties: {${3:kind}: ${4:connected}}",
      ")."
    ],
    "description": "Create an instance graph link"
  },
  "Atom Predicate": {
    "prefix": "isatom",
    "body": ["is_atom(${1:value})."],
    "description": "Test whether a value is a data atom"
  },
  "Type": {
    "prefix": "type",
    "body": ["type(${1:value})."],
    "description": "Return the concrete runtime type name"
  }
}
