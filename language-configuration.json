{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"]
  ],
  "colorizedBracketPairs": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|-?\\d+(?:\\.\\d+)?",
  "autoClosingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:class\\b|def\\b.*=>\\s*$|for\\b.*\\bthen\\s*$|while\\b.*\\bthen\\s*$|switch\\b|try\\b)",
    "decreaseIndentPattern": "^\\s*(?:end\\b|else\\b|case\\b|default\\b|catch\\b)"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
