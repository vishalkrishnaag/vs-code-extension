{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Felidae",
  "scopeName": "source.felidae",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#rules"
    },
    {
      "include": "#typeParameters"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#structures"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#dataTypes"
    },
    {
      "include": "#predicates"
    },
    {
      "include": "#separators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.felidae",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.block.felidae",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.felidae",
          "match": "//.*$"
        },
        {
          "name": "invalid.illegal.comment.removed-number-sign.felidae",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "constant.language.atom.felidae",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "string.quoted.double.Felidae",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.Felidae",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.Felidae",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[Ll]|[Ff])?\\b"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "keyword.control.import.Felidae",
          "match": "\\b(?:import|package)\\b"
        },
        {
          "name": "entity.name.type.import.felidae",
          "match": "(?<=\\bimport\\s)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\.\\*)?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.function.felidae",
          "match": "\\b(?:def|define)\\b(?=\\s+[A-Za-z_][A-Za-z0-9_.]*(?:<[^>]*>)?\\s*\\([^)]*\\)\\s*(?::|=>))"
        },
        {
          "name": "keyword.declaration.function.felidae",
          "match": "\\bdefine\\b"
        },
        {
          "name": "keyword.declaration.variable.felidae",
          "match": "\\bdef\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*(?::|:=))"
        },
        {
          "name": "storage.modifier.static.felidae",
          "match": "\\b(?:private|static|abstract)\\b(?=\\s+(?:static\\s+|abstract\\s+)?(?:class|interface)\\b)"
        },
        {
          "name": "storage.modifier.static.felidae",
          "match": "\\bstatic\\b(?=\\s+init\\b)"
        },
        {
          "name": "keyword.control.init.felidae",
          "match": "(?<=\\bstatic\\s)\\s*init\\b"
        },
        {
          "name": "keyword.declaration.class.felidae",
          "match": "\\bclass\\b"
        },
        {
          "name": "keyword.control.end.felidae",
          "match": "\\bend\\b"
        },
        {
          "name": "keyword.other.directive.felidae",
          "match": "\\b(?:key|index)\\b(?=\\s*\\()"
        },
        {
          "name": "keyword.operator.logical.word.felidae",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "constant.language.felidae",
          "match": "\\b(?:true|false|nil)\\b"
        },
        {
          "name": "keyword.control.felidae",
          "match": "\\b(?:def|extends|implements|else|then|for|in|while|switch|case|default|break|continue|try|catch|new|this|super)\\b"
        },
        {
          "comment": "Reserved by the lexer but rejected by the parser with an explicit migration error (removed block-if, statement-level where/return, fact 'extend', the not-yet-implemented lambda): still real tokens, so still a keyword, not a plain identifier.",
          "name": "invalid.deprecated.keyword.felidae",
          "match": "\\b(?:if|elif|return|where|extend|lambda)\\b"
        }
      ]
    },
    "rules": {
      "patterns": [
        {
          "name": "keyword.operator.rule.Felidae",
          "match": "=>|:=|\\?\\.|\\?:"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.Felidae",
          "match": "!=|<=|>=|(?<![:!<>=])=(?!=)|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.Felidae",
          "match": "[+*/%-]"
        },
        {
          "name": "punctuation.separator.comma.Felidae",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.felidae",
          "match": "\\.(?=\\s*(?:#.*)?$)"
        },
        {
          "name": "punctuation.accessor.felidae",
          "match": "\\."
        }
      ]
    },
    "structures": {
      "patterns": [
        {
          "name": "punctuation.definition.group.Felidae",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.map.Felidae",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.Felidae",
          "match": "[\\[\\]]"
        }
      ]
    },
    "predicates": {
      "patterns": [
        {
          "name": "entity.name.function.predicate.Felidae",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "dataTypes": {
      "patterns": [
        {
          "name": "storage.type.primitive.felidae",
          "match": "\\b(?:int|long|float|double|boolean|char|byte|short|Integer|Long|Float|Double|Character|Byte|Short|String|Boolean|Atom|Any|Object|Nothing|List|Map|Optional|Pair)\\b"
        },
        {
          "name": "entity.name.type.class.felidae",
          "match": "(?<=\\b(?:class|interface|extends|implements|new)\\s)\\s*[A-Za-z_][A-Za-z0-9_.]*"
        },
        {
          "name": "entity.name.type.felidae",
          "match": "(?<=[:<,]\\s?)[A-Z][A-Za-z0-9_.]*(?!\\s*\\()"
        }
      ]
    },
    "separators": {
      "patterns": [
        {
          "name": "punctuation.separator.key-value.Felidae",
          "match": ":"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.felidae",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.felidae",
          "match": "\\b(?:print|range|throw|type|is_atom|len|length|Link|Unlink|Pair)\\b(?=\\s*\\()"
        },
        {
          "name": "support.class.library.felidae",
          "match": "\\b(?:db|system|console)(?=\\s*[:.])"
        },
        {
          "name": "support.function.library.felidae",
          "match": "(?<=\\b(?:db|system|console)[.:])[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "typeParameters": {
      "patterns": [
        {
          "name": "meta.type.parameters.felidae",
          "begin": "(?<=\\b(?:List|Map|Optional|Pair))<",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.begin.felidae"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.felidae"
            }
          },
          "patterns": [
            {
              "include": "#typeParameters"
            },
            {
              "include": "#dataTypes"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.Felidae"
            }
          ]
        }
      ]
    }
  }
}
