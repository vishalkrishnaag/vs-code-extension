{
  "name": "felidae-vscode",
  "displayName": "Felidae",
  "description": "Felidae .fx support with interpreter debugging, diagnostics, and language services.",
  "version": "0.2.2",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/xnvtserver/Felidae.git"
  },
  "homepage": "https://github.com/xnvtserver/Felidae/tree/main/vs-code-extension",
  "bugs": {
    "url": "https://github.com/xnvtserver/Felidae/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:felidae",
    "workspaceContains:**/*.fx",
    "onDebugInitialConfigurations:felidae",
    "onDebugResolve:felidae"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "felidae",
        "aliases": [
          "Felidae",
          "Felidae Logic",
          "felidae"
        ],
        "extensions": [
          ".fx"
        ],
        "icon": {
          "light": "./icons/fx-light.svg",
          "dark": "./icons/fx-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "iconThemes": [
      {
        "id": "felidae-icons",
        "label": "Felidae File Icons",
        "path": "./icons/felidae-icon-theme.json"
      }
    ],
    "themes": [
      {
        "label": "Felidae Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/felidae-dark-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.fx": "felidae"
      }

    },
    "colors": [
      { "id": "felidae.defFunction", "description": "def introducing a function (def f(...) =>).",
        "defaults": { "dark": "#18f0d7", "light": "#0a8f80", "highContrast": "#18f0d7", "highContrastLight": "#006d60" } },
      { "id": "felidae.defFact", "description": "def introducing a persistent fact (def Name(...).).",
        "defaults": { "dark": "#f7a93f", "light": "#b86a00", "highContrast": "#f7a93f", "highContrastLight": "#8a4f00" } },
      { "id": "felidae.defBinding", "description": "def introducing a binding or class field (def x := 1.).",
        "defaults": { "dark": "#c4a2ff", "light": "#6b3fd1", "highContrast": "#c4a2ff", "highContrastLight": "#4f2aa8" } },
      { "id": "felidae.blockLevel0", "description": "Outermost block opener and end under the cursor.",
        "defaults": { "dark": "#ff8ec0", "light": "#c2185b", "highContrast": "#ff8ec0", "highContrastLight": "#8e0f40" } },
      { "id": "felidae.blockLevel1", "description": "Second nesting level of the block highlight.",
        "defaults": { "dark": "#7fd4ff", "light": "#0277bd", "highContrast": "#7fd4ff", "highContrastLight": "#01579b" } },
      { "id": "felidae.blockLevel2", "description": "Third nesting level of the block highlight.",
        "defaults": { "dark": "#f7c76b", "light": "#b26a00", "highContrast": "#f7c76b", "highContrastLight": "#7a4900" } },
      { "id": "felidae.blockLevel3", "description": "Fourth nesting level of the block highlight (then colours repeat).",
        "defaults": { "dark": "#a6e3a1", "light": "#2e7d32", "highContrast": "#a6e3a1", "highContrastLight": "#1b5e20" } },
      { "id": "felidae.blockHighlightBackground", "description": "Background of the innermost block's opener and end.",
        "defaults": { "dark": "#7f7f7f40", "light": "#7f7f7f33", "highContrast": "#7f7f7f66", "highContrastLight": "#7f7f7f4d" } }
    ],
    "keybindings": [
      {
        "command": "felidae.runCellAndAdvance",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == felidae && resourceScheme == file && !suggestWidgetVisible"
      },
      {
        "command": "felidae.runCell",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus && editorLangId == felidae && resourceScheme == file"
      }
    ],
    "taskDefinitions": [
      {
        "type": "felidae",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "enum": ["run", "check"],
            "description": "run executes the file; check prints parse diagnostics and symbols as JSON."
          },
          "file": {
            "type": "string",
            "description": "Path to the .fx file. Defaults to the active editor's file."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "felidae",
        "label": "Felidae interpreter errors",
        "owner": "felidae",
        "source": "felidae",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^error: (?:(.+?\\.fx): )?(.*?),? ?(?:at )?line (\\d+), column (\\d+)\\S*$",
          "file": 1,
          "message": 2,
          "line": 3,
          "column": 4
        }
      }
    ],
    "breakpoints": [
      {
        "language": "felidae"
      }
    ],
    "grammars": [
      {
        "language": "felidae",
        "scopeName": "source.felidae",
        "path": "./syntaxes/felidae.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "felidae",
        "scopes": {
          "felidaeDefBinding": ["keyword.declaration.variable.felidae"],
          "felidaeDefFunction": ["keyword.declaration.function.felidae"],
          "felidaeDefFact": ["keyword.declaration.struct.felidae"]
        }
      }
    ],
    "snippets": [
      {
        "language": "felidae",
        "path": "./snippets/felidae.json"
      }
    ],
    "commands": [
      {
        "command": "felidae.showOutput",
        "title": "Felidae: Show Output"
      },
      { "command": "felidae.runCell", "title": "Felidae: Run Cell", "icon": "$(play)" },
      { "command": "felidae.runCellAndAdvance", "title": "Felidae: Run Cell and Advance" },
      { "command": "felidae.runCellsBelow", "title": "Felidae: Run Cell and Cells Below" },
      { "command": "felidae.runAllCells", "title": "Felidae: Run All Cells", "icon": "$(run-all)" },
      { "command": "felidae.debugCell", "title": "Felidae: Debug Cell", "icon": "$(debug-alt)" },
      { "command": "felidae.stopCell", "title": "Felidae: Stop Running Cell" },
      { "command": "felidae.clearCellResults", "title": "Felidae: Clear Cell Results" },
      {
        "command": "felidae.runMain",
        "title": "Felidae: Run",
        "icon": "$(play)"
      },
      {
        "command": "felidae.debugMain",
        "title": "Felidae: Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "felidae.runQuery",
        "title": "Felidae: Run Query",
        "icon": "$(terminal)"
      },
      {
        "command": "felidae.formatDocument",
        "title": "Felidae: Format Document",
        "icon": "$(list-flat)"
      }
    ],
    "debuggers": [
      {
        "type": "felidae",
        "label": "Felidae",
        "languages": [
          "felidae"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Felidae source file to run.",
                "default": "${file}"
              },
              "interpreterPath": {
                "type": "string",
                "description": "Path to the felidae interpreter executable (the same binary Run uses). There is no separate compiler or VM to run first.",
                "default": ""
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before executing the program so VS Code Continue resumes Felidae.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "felidae",
            "request": "launch",
            "name": "Debug Felidae Main",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ],
    "configuration": {
      "title": "Felidae",
      "properties": {
        "felidae.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show the parameter name before each positional call argument (editor.inlayHints.enabled must allow hints)."
        },
        "felidae.cells.inlineResults": {
          "type": "boolean",
          "default": true,
          "description": "Show a cell's result or error after its def line."
        },
        "felidae.cells.runTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Stop a cell's felidae process if it has not finished after this many seconds."
        },
        "felidae.autoInsertEnd": {
          "type": "boolean",
          "default": true,
          "description": "After Enter on a block opener (def ... =>, class, for/while ... then, switch, try) that has no matching end, insert the end line below."
        },
        "felidae.endLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show a faint label after the `end` of the block under the cursor, naming the def, class, for, while, switch or try block it closes."
        },
        "felidae.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "Path to the felidae interpreter (reads source.fx, parses it, and executes the AST directly - no separate compiler or VM). When empty, staged release locations under dist/bin are searched. Relative paths are resolved from the workspace folder."
        },
        "felidae.defaultQuery": {
          "type": "string",
          "default": "employee.where(active: true).",
          "description": "Default period-terminated bucket expression shown by Felidae: Run Query."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "felidae.runMain",
          "when": "resourceLangId == felidae"
        },
        {
          "command": "felidae.debugMain",
          "when": "resourceLangId == felidae"
        },
        {
          "command": "felidae.runQuery",
          "when": "resourceLangId == felidae"
        },
        {
          "command": "felidae.formatDocument",
          "when": "resourceLangId == felidae"
        }
      ],
      "editor/context": [
        {
          "command": "felidae.runMain",
          "when": "resourceLangId == felidae",
          "group": "navigation"
        },
        {
          "command": "felidae.debugMain",
          "when": "resourceLangId == felidae",
          "group": "navigation"
        },
        {
          "command": "felidae.runQuery",
          "when": "resourceLangId == felidae",
          "group": "navigation"
        },
        {
          "command": "felidae.formatDocument",
          "when": "resourceLangId == felidae",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "felidae.runMain",
          "when": "resourceLangId == felidae && felidaeHasMain",
          "group": "navigation@1"
        },
        {
          "command": "felidae.debugMain",
          "when": "resourceLangId == felidae && felidaeHasMain",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./ && node esbuild.js --production",
    "test:runtime": "node test/runtime.test.js",
    "generate:libraries": "node scripts/generate-libraries.js",
    "generate:builtin-docs": "node scripts/generate-builtin-docs.js",
    "generate:models": "node scripts/generate-models.js",
    "precompile": "npm run generate:libraries && npm run generate:builtin-docs && npm run generate:models && npm run generate:icon",
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "watch:types": "tsc -watch -p ./ --noEmit",
    "lint": "node --check dist/extension.js",
    "generate:icon": "node scripts/generate-icon.js",
    "test": "node test/run-all.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {},
  "icon": "icons/felidae-icon.png",
  "keywords": [
    "felidae",
    "fx",
    "logic programming",
    "facts",
    "language services"
  ],
  "galleryBanner": {
    "color": "#0b1412",
    "theme": "dark"
  }
}
